  "limits": [
    "Not a DTCG-conformance claim.",
    "Only listed opaque color pairs are checked; no automatic DOM, gradients or alpha compositing.",
    "Brand accents and subtle separators are not approved as normal text or necessary control boundaries.",
    "Font names are fallback references; no font files are distributed or fetched."
  ]
