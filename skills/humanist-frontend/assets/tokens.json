{
  "format": "humanist-frontend-tokens",
  "format_version": 1,
  "design_version": "0.3.0",
  "provenance": "Original project defaults inspired by public sources; not an official brand system. Some brand reference hues are retained as decorative references.",
  "color_encoding": "opaque-srgb-hex-6",
  "common": {
    "font-ui": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
    "font-editorial": "Georgia, \"Songti SC\", \"Noto Serif CJK SC\", serif",
    "font-mono": "ui-monospace, SFMono-Regular, Consolas, \"Liberation Mono\", monospace",
    "space-4": "0.25rem",
    "space-8": "0.5rem",
    "space-12": "0.75rem",
    "space-16": "1rem",
    "space-24": "1.5rem",
    "space-32": "2rem",
    "space-48": "3rem",
    "space-64": "4rem",
    "radius-control": "0.5rem",
    "radius-panel": "0.75rem",
    "radius-dialog": "1rem",
    "control-size": "2.5rem",
    "target-touch": "2.75rem",
    "body-size": "1rem",
    "ui-size": "0.875rem",
    "caption-size": "0.8125rem",
    "line-ui": "1.5",
    "line-reading": "1.7",
    "motion-fast": "120ms",
    "motion-base": "180ms",
    "motion-panel": "240ms",
    "ease-standard": "cubic-bezier(0.2, 0, 0, 1)"
  },
